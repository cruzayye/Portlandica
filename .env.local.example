NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Partner sign-in (see SETUP.md). Server-only: never add a NEXT_PUBLIC_ prefix.
# Comma-separated emails allowed to use the app. Keep it the same as the
# private.partner_emails table in Supabase. Empty means nobody can sign in.
ALLOWED_EMAILS=partner-one@example.com,partner-two@example.com
# true shows "Continue with Google" on /login. Turn on the Google provider in
# Supabase first.
ENABLE_GOOGLE_LOGIN=false

# Google Sheets
GOOGLE_SHEET_ID=your-spreadsheet-id
# Paste the entire service account JSON as a single line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
