NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# Team sign-in and the server's database key (see SETUP.md). Server-only: never add a
# NEXT_PUBLIC_ prefix to any of these three, and never commit their values.
# Supabase -> Project Settings -> API Keys -> Secret keys. It bypasses every database rule.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# The one password the team signs in with: at least 12 characters (a 4-5 word
# passphrase). Left empty, nobody can sign in.
TEAM_PASSWORD=
# Signs the session cookie: at least 32 characters. Make one with: openssl rand -hex 32
SESSION_SECRET=

# Google Sheets
GOOGLE_SHEET_ID=your-spreadsheet-id
# Paste the entire service account JSON as a single line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Trello: every order gets a delivery card (src/lib/trello.ts). Server-only.
TRELLO_API_KEY=your-trello-api-key
TRELLO_TOKEN=your-trello-token
# The list new cards go on, and the board whose fill-date labels they get.
TRELLO_LIST_ID=your-trello-list-id
TRELLO_BOARD_ID=your-trello-board-id

# Square draft invoices for orders with Create Invoice on (src/lib/square.ts,
# docs/integrations.md). Server-only. Leave SQUARE_ACCESS_TOKEN empty to skip
# the invoice step; the app says so on each such order.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=your-square-location-id

# A.I.P Numbers tab (docs/aip-numbers.md). Server-only: the Apps Script web app's URL
# (it ends in /exec) and the token saved in its DASHBOARD_TOKEN script property. Until
# both are set, the tab says A.I.P Numbers isn't connected.
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=
